// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

enum CourseType {
  LIVE
  RECORDED
}

enum PaymentMode {
  cash
  installments
}

enum PaymentStatus {
  pending
  approved
  rejected
  cancelled
  expired
  failed
  refunded
}

enum PaymentMethod {
  mercadopago
  paypal
  nowpayments
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String?
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now())
  purchases     Purchase[]
  subscriptions Subscription[]
  enrollments   Enrollment[]
}

model Course {
  id                  String            @id @default(uuid())
  slug                String            @unique
  title               String
  shortDescription    String
  longDescription     String
  price               Float
  priceARS            Int?
  priceUSD            Int?
  originalPriceARS    Int?
  originalPriceUSD    Int?
  paymentMode         PaymentMode       @default(cash)
  durationInMonths    Int?
  duration            String?
  sortOrder           Int               @default(0)
  type                CourseType
  videoUrl            String?
  scheduledAt         DateTime?
  thumbnail           String?
  instructorName      String?
  instructorRole      String?
  instructorBio       String?
  descriptionSections Json?
  available           Boolean           @default(true)
  fakeEnrollments     Int?
  createdAt           DateTime          @default(now())
  purchases           Purchase[]
  startDates          CourseStartDate[]
  priceUSDT           Decimal?          @db.Decimal(18, 6)
  originalPriceUSDT   Decimal?          @db.Decimal(18, 6)
  enrollments         Enrollment[]
}

model Purchase {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentMethod     PaymentMethod
  providerPaymentId String?
  amount            Decimal       @db.Decimal(18, 6)
  currency          String
  checkoutUrl       String?
  providerStatus    String?
  status            PaymentStatus @default(pending)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  enrollment        Enrollment?
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime
}

model CourseStartDate {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startDate   DateTime
  startTime   String?
  teacherName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
}

model Enrollment {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  purchaseId String?   @unique
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@unique([userId, courseId])
}
