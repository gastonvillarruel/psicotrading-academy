# Reference only. New private profile, never the backup profile. Store outside Git with restricted ACLs.
SNIPERS_ENABLED=false
SNIPERS_LAUNCH_ENVIRONMENT=production
SNIPERS_MIGRATION_TRANSPORT=session-pooler
SNIPERS_MIGRATION_INTERNAL_TLS_POLICY=supabase-managed
SNIPERS_MIGRATION_PROJECT_REF=qvakwkvfbsqprzcdywsi
SNIPERS_MIGRATION_SQL_ROLE=postgres
SNIPERS_LAUNCH_DATABASE_URL=
# Canonical URL: exact approved pooler hostname, 5432, verify-full and absolute sslrootcert.
# Native Prisma URL is derived internally: require + strict + sslcert, with the same identity and CA.
SNIPERS_EXPECT_HOST=
SNIPERS_EXPECT_PORT=5432
SNIPERS_EXPECT_DATABASE=postgres
SNIPERS_EXPECT_USER=postgres.qvakwkvfbsqprzcdywsi
# No backup transport or backup TLS-policy keys are accepted here.
