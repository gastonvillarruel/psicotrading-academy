# Reference only. Do not enable until the Linux sandbox and real R2 test integration are verified.
SNIPERS_ENABLED=false
SNIPERS_FILE_VALIDATION_ENABLED=false
# Official signed main.cvd + daily.cvd; optional signed bytecode.cvd. No CLD for policy 1.
SNIPERS_CLAMAV_DATABASE_DIRECTORY=/var/lib/clamav
# Must be writable by the existing worker AND visible to the system service manager.
# The existing unit uses PrivateTmp: do not use /tmp here.
# Provision StateDirectory=snipers-validation (0700) on the existing worker unit before enabling.
SNIPERS_VALIDATION_TEMP_DIRECTORY=/var/lib/snipers-validation
