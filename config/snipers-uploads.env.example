# Reference only. No automatic loading or production credentials.
SNIPERS_ENABLED=false
SNIPERS_ENVIRONMENT=local
SNIPERS_UPLOAD_PROCESSOR_ENABLED=false
SNIPERS_FILE_VALIDATION_ENABLED=false
SNIPERS_STORAGE_CLEANUP_ENABLED=false
# Before real use: verify NO incomplete-multipart abort rule covers snipers/temporary/.
# Sealed COMPLETING may still need its parts indefinitely. Also exclude needed objects
# from object-expiration rules. SQL preservation cannot recover provider-deleted parts.
SNIPERS_R2_ENVIRONMENT=test
SNIPERS_R2_TEST_ACCOUNT_ID=
SNIPERS_R2_TEST_BUCKET=snipers-test-campus
SNIPERS_R2_TEST_ACCESS_KEY_ID=
SNIPERS_R2_TEST_SECRET_ACCESS_KEY=
# Select exactly ONE populated group. staging requires SNIPERS_ENVIRONMENT=staging;
# production requires SNIPERS_ENVIRONMENT=production. Never populate production keys in Preview.
# Prefixes prevent configuration mistakes; only bucket-scoped tokens enforce actual access.
# Default-jurisdiction private buckets only. No public r2.dev/custom-domain access.
SNIPERS_R2_STAGING_ACCOUNT_ID=
SNIPERS_R2_STAGING_BUCKET=
SNIPERS_R2_STAGING_ACCESS_KEY_ID=
SNIPERS_R2_STAGING_SECRET_ACCESS_KEY=
SNIPERS_R2_PRODUCTION_ACCOUNT_ID=
SNIPERS_R2_PRODUCTION_BUCKET=
SNIPERS_R2_PRODUCTION_ACCESS_KEY_ID=
SNIPERS_R2_PRODUCTION_SECRET_ACCESS_KEY=
# Processor: set DATABASE_URL explicitly in its private EnvironmentFile.
# Never use production PostgreSQL/R2 for this phase's checks.
