# Reference only: never loaded automatically. Real profile and CA live outside Git with private ACLs.
SNIPERS_ENABLED=false
SNIPERS_LAUNCH_ENVIRONMENT=production
SNIPERS_BACKUP_TRANSPORT=session-pooler
SNIPERS_LAUNCH_DATABASE_URL=
# URL: exact Session Pooler host, port 5432, sslmode=verify-full, absolute sslrootcert path.
SNIPERS_EXPECT_HOST=
SNIPERS_EXPECT_PORT=5432
SNIPERS_EXPECT_DATABASE=
# Login is ROLE.PROJECT_REF; SQL current_user must separately match EXPECT_ROLE.
SNIPERS_EXPECT_USER=
SNIPERS_BACKUP_EXPECT_ROLE=
SNIPERS_BACKUP_EXPECT_PROJECT_REF=
# Pending blocks BEFORE connecting. require rejects upstream TLS=false.
# supabase-managed accepts the provider-managed upstream ONLY for this backup transport;
# CA/hostname verification between this computer and the pooler remains mandatory.
SNIPERS_BACKUP_INTERNAL_TLS_POLICY=pending
PG_BIN=
# Existing CLI, only after separate authorization:
# npm run db:backup -- --launch-profile PRIVATE_PROFILE --allow-remote-read
# Output: backups/snipers-launch/*.dump and *.dump.json, private ACLs, ignored by Git.
# Restoration: dedicated local launch profile; optional SNIPERS_RESTORE_EXTENSION_REVIEW
# points to a private JSON based on snipers-restore-extensions.example.json, bound to archive SHA-256.
# Review public SQL/function bodies (including dynamic SQL) and the TOC before approving inventory-only.
# Required dependencies must already exist in the isolated destination with matching schema/version.
# Unknown extensions, omitted dependencies and unexpected TOC objects remain blocked. No automatic provisioning.
