# REFERENCE ONLY. Never loaded automatically. Store real profiles outside Git with private ACL/mode.
# No production operations authorized by this example or by completion of Block A.
SNIPERS_ENABLED=false
SNIPERS_LAUNCH_ENVIRONMENT=local
SNIPERS_LAUNCH_DATABASE_URL=
SNIPERS_EXPECT_HOST=127.0.0.1
SNIPERS_EXPECT_PORT=55432
SNIPERS_EXPECT_DATABASE=
SNIPERS_EXPECT_USER=
# Remote reads require an explicit profile, exact expected identity, sslmode=verify-full
# and --allow-remote-read. Use a direct endpoint, not transaction pooling.
# PG_BIN can point to the PostgreSQL client directory. No URL/password in command arguments.
PG_BIN=
