# Reference only. db:local setup generates .env.snipers.local with random secrets.
# Never copy the production .env into this profile.
SNIPERS_ENVIRONMENT=local
PG_BIN="F:/PostgreSQL-Snipers/pgsql/bin"
DATABASE_URL="postgresql://snipers_local:GENERATED_PASSWORD@127.0.0.1:55432/snipers_dev?schema=public&sslmode=disable"
DIRECT_URL="postgresql://snipers_local:GENERATED_PASSWORD@127.0.0.1:55432/snipers_dev?schema=public&sslmode=disable"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="GENERATED_LOCAL_SECRET"
ENABLE_SINGLE_SESSION=true
SNIPERS_ENABLED=false
